# PlugPakka: Apache config for public_html (GoDaddy cPanel).
# Upload next to index.html ONLY after the SSL certificate is active, or the site won't load.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType font/woff2 .woff2

RewriteEngine On

# Sends http:// and www. visitors to https://plugpakka.com
# (/.well-known/ is left alone so AutoSSL can still validate if the certificate ever lapses.)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://plugpakka.com%{REQUEST_URI} [L,R=301]

# Refuse dotfiles and dot-folders (.git, .env, .htpasswd ...) except /.well-known/
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

# Flag Next's fingerprinted build files so they can be cached forever (see Cache-Control below).
RewriteRule ^_next/static/ - [E=PP_IMMUTABLE:1]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # 'unsafe-inline' is required: the static export inlines Next's bootstrap/RSC <script>s and React style="" attributes,
  # and there is no server to add nonces. Everything else is locked to this site only.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

  Header set Cache-Control "public, max-age=31536000, immutable" env=PP_IMMUTABLE
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
